                <div class="flex flex-col gap-10 w-1/3 border-l border-grey-500 dark:border-neutral-500 px-2">
                    {# Left Column #}
                    <div class="bg-pink-50 rounded-lg p-4 mt-6">
                        <div class="flex justify-between items-center mb-2">
                            <h3 class="font-semibold">Quiz de l'épisode</h3>
                            <button class="px-4 py-2 bg-black text-white rounded-lg">Démarrer</button>
                        </div>
                        <p class="text-sm text-gray-600">Lancez le quiz du dernier épisode du podcast !</p>
                    </div>

                    {# Right Column #}
                    <div class="bg-pink-50 rounded-lg p-6">
