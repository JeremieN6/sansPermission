<div class="flex flex-col gap-10 w-full lg:w-1/3 border-l border-grey-500 dark:border-neutral-500 px-2">
    {# Left Column #}
    <div class="text-gray-900 bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500rounded-xl rounded-lg p-4 mt-6 rounded-lg p-4 mt-6">
        <div class="flex justify-between items-center mb-2">
            <h3 class="font-semibold">Quiz de l'épisode</h3>
            <a href="{{ dernierQuiz ? path('quiz_game', {'id': dernierQuiz.id}) : '#' }}">
                <button class="px-4 py-2 bg-gray-800 hover:bg-gray-700 text-white dark:bg-white dark:text-gray-800 font-semibold rounded-lg">Démarrer</button>
            </a>
        </div>
        <p class="text-sm text-gray-600 dark:text-white">Lancez le quiz du dernier épisode du podcast !</p>
    </div>

    {# Right Column #}
    <div class="text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 dark:bg-gray-800 dark:text-white rounded-lg p-4 mt-6 rounded-lg p-6">
        <h3 class="font-semibold text-gray-700 dark:text-white mb-4">Classement</h3>
        <div class="space-y-4">
            {% for player in listPlayer %}
                <div class="flex items-center justify-between bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500rounded-xl p-3 rounded-lg">
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 bg-gray-200 text-gray-700 text-semibold dark:bg-white dark:text-gray-700 rounded-full flex items-center justify-center">{{ loop.index }}</span>
                        <span class="text-gray-700 dark:text-gray-200">{{player.user.pseudo}}</span>
                    </div>
                    <span class="text-gray-700 dark:text-gray-200">{{player.score}} Points</span>
                </div>
            {% endfor %}
        </div>
        <a href="{{path('classement_general')}}">
            <div class="text-white text-center bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mt-4 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800 cursor-pointer">
                    Voir le classement complet
            </div>
            </a>
    </div>
</div>