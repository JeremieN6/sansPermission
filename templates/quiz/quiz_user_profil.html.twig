{% extends 'base_login.html.twig' %}

{% block title %}Profil Quiz - Sans Permission
{% endblock %}

{% block body %}
	<div class="flex h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-white">
		{% include 'quiz/_navbar.html.twig' %}
		<div class="flex-1 overflow-auto">
			<div class="p-8">
				<div class="flex items-center gap-6 mb-8">
					<div class="w-32 h-32 rounded-full flex items-center justify-center bg-white border border-gray-200 rounded-full dark:bg-gray-800 dark:border-gray-700 border-4 border-gray-300 text-6xl font-bold text-gray-700 dark:text-white select-none">
						{{ pseudo|slice(0, 1)|upper }}
					</div>
					<div>
						<h2 class="text-3xl font-bold mb-1">Mon Profil</h2>
						<div class="flex items-center text-sm text-gray-600 gap-2">
							<span>🎧</span>
							<span>Profil Sans Permission de
								{{ prenom }}</span>
						</div>
					</div>
				</div>

				<div class="mb-8">
					<h3 class="text-xl font-semibold mb-4">Statistiques de Quiz général</h3>
					<div class="flex gap-6">
						<div class="flex-1 rounded-xl p-6 flex flex-col items-center bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700">
							<span class="text-2xl font-bold">Quiz Total</span>
							<span class="text-2xl font-bold">{{ quiz_total }}</span>
						</div>
						<div class="flex-1 rounded-xl p-6 flex flex-col items-center bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700">
							<span class="text-2xl font-bold">Épisodes Total</span>
							<span class="text-2xl font-bold">{{ episode_total }}</span>
						</div>
						{# <div class="flex-1 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 rounded-xl p-6 flex flex-col items-center">
						                            <span class="text-lg font-semibold">Podcast</span>
						                            <span class="text-2xl font-bold">Quiz Followers</span>
						                        </div> #}
					</div>
				</div>

				<div class="mb-8">
					<h3 class="text-xl font-semibold mb-4">Mes statistiques de Quiz</h3>
					<div class="flex gap-6">
						<div class="flex flex-col md:flex-row justify-center items-start md:items-center w-full my-5 gap-5">
							<div class="block w-full md:w-1/3 p-6 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700">
								<p class="font-normal text-gray-700 dark:text-gray-400">Quiz terminé</p>
								<div class="flex items-center justify-between">
									<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{{ user_quiz_total }}</h5>
									<svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
									<path fill-rule="evenodd" d="M12 2c-.791 0-1.55.314-2.11.874l-.893.893a.985.985 0 0 1-.696.288H7.04A2.984 2.984 0 0 0 4.055 7.04v1.262a.986.986 0 0 1-.288.696l-.893.893a2.984 2.984 0 0 0 0 4.22l.893.893a.985.985 0 0 1 .288.696v1.262a2.984 2.984 0 0 0 2.984 2.984h1.262c.261 0 .512.104.696.288l.893.893a2.984 2.984 0 0 0 4.22 0l.893-.893a.985.985 0 0 1 .696-.288h1.262a2.984 2.984 0 0 0 2.984-2.984V15.7c0-.261.104-.512.288-.696l.893-.893a2.984 2.984 0 0 0 0-4.22l-.893-.893a.985.985 0 0 1-.288-.696V7.04a2.984 2.984 0 0 0-2.984-2.984h-1.262a.985.985 0 0 1-.696-.288l-.893-.893A2.984 2.984 0 0 0 12 2Zm3.683 7.73a1 1 0 1 0-1.414-1.413l-4.253 4.253-1.277-1.277a1 1 0 0 0-1.415 1.414l1.985 1.984a1 1 0 0 0 1.414 0l4.96-4.96Z" clip-rule="evenodd"/>
									</svg>
								</div>
							</div>
							<div class="block w-full md:w-1/3 p-6 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700">
								<p class="font-normal text-gray-700 dark:text-gray-400">Score total</p>
								<div class="flex items-center justify-between">
									<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">{{ user_score_total }}</h5>
									<svg class="w-6 h-6 text-gray-700 dark:text-gray-300" fill="currentColor" viewBox="0 0 24 24">
									<path d="M7 21H3V10h4v11zm7 0h-4V3h4v18zm7 0h-4v-6h4v6z" />
									</svg>
								</div>
							</div>
							<div class="block w-full md:w-1/3 p-6 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700">
								<p class="font-normal text-gray-700 dark:text-gray-400">TOP 1</p>
								<div class="flex items-center justify-between">
									<h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">31</h5>
									<svg class="w- h-6 text-gray-800 dark:text-white" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
									<path fill-rule="evenodd" d="M5 3a1 1 0 00-1 1v2a5 5 0 004 4.9A6 6 0 0011 17v1H8a1 1 0 100 2h8a1 1 0 100-2h-3v-1a6 6 0 003-6.1A5 5 0 0020 6V4a1 1 0 00-1-1h-2a1 1 0 00-1 1v1H8V4a1 1 0 00-1-1H5zm1 3V5h1v1.8a3 3 0 01-2-2.8zm12 0V5h1v.8a3 3 0 01-2 2.8V6z" clip-rule="evenodd" />
									</svg>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="mb-8">
					<h3 class="text-xl font-semibold mb-4">Mes réalisations sur les Quiz</h3>
					<div class="flex flex-col gap-4">
						<div class="flex bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 rounded-xl p-4 items-center">
							<div class="bg-pink-200 rounded-xl p-4 flex items-center justify-center mr-4">
								<span class="text-3xl">⏳</span>
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-center mb-1">
									<span class="font-bold">Série de Quiz</span>
									<span class="text-sm">2/3 semaines</span>
								</div>
								<div class="w-full h-2 bg-gray-200 rounded-full mb-1">
									<div class="h-2 bg-gray-500 rounded-full" style="width:66%"></div>
								</div>
								<span class="text-xs text-gray-600">Série du nombre de quiz terminé</span>
							</div>
						</div>
						<div class="flex bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 rounded-xl p-4 items-center">
							<div class="bg-pink-200 rounded-xl p-4 flex items-center justify-center mr-4">
								<span class="text-3xl">🏆</span>
							</div>
							<div class="flex-1">
								<div class="flex justify-between items-center mb-1">
									<span class="font-bold">Nombre de points de Quiz</span>
									<span class="text-sm">1200/3000 Points</span>
								</div>
								<div class="w-full h-2 bg-gray-200 rounded-full mb-1">
									<div class="h-2 bg-gray-500 rounded-full" style="width:40%"></div>
								</div>
								<span class="text-xs text-gray-600">Nombre de points total obtenu lors des quiz</span>
							</div>
						</div>
					</div>
				</div>

				<div class="mb-8">
					<h3 class="text-xl font-semibold mb-4">Comparaison avec la moyenne des joueurs</h3>
					<div class="flex gap-6">
						<div class="flex-1 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 rounded-xl p-6 flex flex-col items-center">
							<span class="text-lg font-semibold">Score moyen global</span>
							<span class="text-2xl font-bold text-blue-700">{{ global_avg }}</span>
						</div>
						<div class="flex-1 bg-white border border-gray-200 rounded-lg dark:bg-gray-800 dark:border-gray-700 rounded-xl p-6 flex flex-col items-center">
							<span class="text-lg font-semibold">% de bonnes réponses</span>
							<span class="text-2xl font-bold text-green-700">{{ percent_correct }}%</span>
						</div>
					</div>
				</div>

				<div class="flex gap-8 mb-8">
					<div class="flex-1 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700 rounded-2xl p-6">
						<h3 class="text-lg font-semibold mb-4">Récompenses - Mes Badges</h3>
						<div class="flex flex-col gap-4 mb-4">
							<div class="flex items-center justify-between bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500rounded-xl p-3">
								<div class="flex items-center gap-3">
									<img src="https://www.placehold.co/40x40" class="w-10 h-10 rounded-full" alt="Speaker 2">
									<span>Finir 1 Quiz</span>
								</div>
							</div>
							<div class="flex items-center justify-between bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500rounded-xl p-3">
								<div class="flex items-center gap-3">
									<img src="https://www.placehold.co/40x40" class="w-10 h-10 rounded-full" alt="Speaker 1">
									<span>Faire 3 TOP #1</span>
								</div>
							</div>
						</div>
						<button class="bg-black text-white rounded-lg px-6 py-2">Tableau des récompenses</button>
					</div>
					<div class="flex-1 bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700 rounded-2xl p-6">
						<h3 class="text-lg font-semibold mb-4">Classement par Quiz</h3>
						<div class="mb-4">
							<label for="quizSelect" class="block mb-2 text-sm font-medium">Choisir un quiz :</label>
							<select id="quizSelect" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
								<option value="Quiz1">Quiz 1</option>
								<option value="Quiz2">Quiz 2</option>
								<option value="Quiz3">Quiz 3</option>
							</select>
						</div>
						<div
							id="classement-quiz">
							<!-- Classement dynamique ici -->
							<div class="flex flex-col gap-4 mb-4">
								<div class="flex items-center justify-between bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500rounded-xl p-3">
									<div class="flex items-center gap-3">
										<img src="https://www.placehold.co/40x40" class="w-10 h-10 rounded-full" alt="Avatar 1">
										<span>Pseudo du joueur</span>
									</div>
									<button class="bg-black text-white rounded-full px-4 py-1">1<sup>er</sup>
									</button>
								</div>
								<!-- ... -->
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<script>
		function updateClassement() {
// Ici, tu pourrais faire un appel AJAX pour charger le classement du quiz sélectionné
// Pour la démo, tu peux juste changer le contenu de #classement-quiz
// Exemple :
const select = document.getElementById('quiz-select');
const classementDiv = document.getElementById('classement-quiz');
classementDiv.innerHTML = `<div class="flex items-center justify-between bg-gray-400 rounded-xl p-3">
                    <div class="flex items-center gap-3">
                        <img src="https://www.placehold.co/40x40" class="w-10 h-10 rounded-full" alt="Avatar 1">
                        <span>Joueur du quiz ${
select.value
}</span>
                    </div>
                    <button class="bg-black text-white rounded-full px-4 py-1">1<sup>er</sup></button>
                </div>`;
}
	</script>
{% endblock %}
