{% extends 'base_login.html.twig' %}

{% block title %}PodQuizMaster - Liste des Quiz{% endblock %}

{% block body %}
<div class="flex h-screen bg-gray-50">
    {% include 'quiz/_navbar.html.twig' %}

    <div class="flex-1 overflow-auto">
        <div class="p-8">
            <div class="flex justify-between items-center mb-8">
                <h2 class="text-2xl font-bold">Les Quiz Sans Permission</h2>
            </div>

            <div class="flex gap-5">
                {# Quiz Grid #}
                <div class="w-full">
                    {# Sidebar Filters #}
                    <div class="w-full mb-4">
                        <div class="bg-white rounded-lg shadow p-4">
                            <h3 class="font-semibold mb-4">Filtrer les Quiz</h3>
                            <div class="space-y-3">
                                <button class="w-full text-left px-4 py-2 rounded hover:bg-gray-100 font-medium">
                                    Par popularité
                                </button>
                                <button class="w-full text-left px-4 py-2 rounded hover:bg-gray-100">
                                    Plus récent
                                </button>
                                <button class="w-full text-left px-4 py-2 rounded hover:bg-gray-100">
                                    Plus ancien
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-6">
                        {% for quizzes in allQuizzes %}
                        <div class="bg-white rounded-lg shadow overflow-hidden">
                            <div class="aspect-video bg-gray-100">
                                {% if quizzes.thumbnail is defined %}
                                    <img src="{{ quizzes.thumbnail }}" alt="Miniature épisode {{ quizzes.episodeId.id }}" class="w-full h-full object-cover">
                                {% else %}
                                    <img src="https://placehold.co/400x225" alt="Miniature épisode par défaut" class="w-full h-full object-cover">
                                {% endif %}
                            </div>
                            <div class="p-4">
                                <span class="text-sm text-gray-500">Episode Quiz #{{quizzes.episodeId.id}}</span>
                                <h3 class="font-semibold text-lg mb-3">{{quizzes.title}}</h3>
                                <a href="{{ path('quiz_game', {'id': quizzes.id}) }}">
                                     <button class="w-full bg-[#003737] text-white py-2 px-4 rounded-lg hover:bg-[#004747] transition">
                                        Démarrer le Quiz
                                    </button>
                                </a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    {# Rewards Section #}
                    <div class="mt-12">
                        <div class="text-center max-w-2xl mx-auto">
                            <h2 class="text-2xl font-bold mb-4">🎁 Cumulez des points et gagnez des récompenses</h2>
                            <p class="text-gray-600 mb-6">
                                En répondant correctement aux quiz, vous cumulez des points qui vous permettront de gagner des cadeaux de grande valeur. Plus vous participez, plus vous augmentez vos chances de gagner !
                            </p>
                            <div class="flex justify-center items-center space-x-6">
                                <div class="text-center">
                                    <div class="bg-[#003737] text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-2">
                                        <span class="text-2xl">🎯</span>
                                    </div>
                                    <p class="text-sm font-medium">Précision</p>
                                </div>
                                <div class="text-center">
                                    <div class="bg-[#003737] text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-2">
                                        <span class="text-2xl">⚡</span>
                                    </div>
                                    <p class="text-sm font-medium">Rapidité</p>
                                </div>
                                <div class="text-center">
                                    <div class="bg-[#003737] text-white rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-2">
                                        <span class="text-2xl">🏆</span>
                                    </div>
                                    <p class="text-sm font-medium">Récompenses</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% include 'quiz/_side.html.twig' %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
