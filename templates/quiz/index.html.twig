{% extends 'base_login.html.twig' %}

{% block title %}PodQuizMaster - Accueil
{% endblock %}

{% block body %}
	{% set podcasteurs = ['podcasteur-1.webp', 'podcasteur-2.webp', 'podcasteur-3.webp'] %}
	<div class="flex h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-white">
		{% include 'quiz/_navbar.html.twig' %}

		{# Main Content #}
		<div class="flex-1 overflow-auto">
			<div
				class="p-8">
				{# Header with User Info #}
				<div class="flex justify-between items-center mb-8">
					<h2 class="text-2xl font-bold">Bienvenue sur le Quiz Sans Permission, User!</h2>
					<div class="flex items-center">
						<img src="https://www.placehold.co/48x48" alt="User Avatar" class="w-10 h-10 rounded-full">
					</div>
				</div>
				<div class="flex gap-5 w-full">
					<div
						class="w-2/3">
						{# Episode Info #}
						<div class="mb-8">
							<h3 class="text-lg font-semibold mb-4">Nos podcasteurs</h3>
							<div class="flex gap-4 mb-4">
								{% for podcasteur in podcasteurs %}
									<div class="w-12 h-12 bg-gray-200 rounded-full overflow-hidden">
										<img src="{{ asset('assets/images/podcasteurs/' ~ podcasteur) }}" alt="Speaker {{ loop.index }}" class="w-full h-full object-cover">
									</div>
								{% endfor %}
							</div>
						</div>
						<hr class="border-grey-800 dark:border-neutral-500">

						<div class="py-12">
							<div class="max-w-9xl mx-auto">
								<div class="flex justify-between" id="episodes_ancre">
									<h2 class="font-bold text-#091D1C mb-6">Derniers épisodes</h2>
									<a href="https://www.youtube.com/@sanspermissionpodcast/videos" target="_blank" class="text-#091D1C font-medium hover:text-green-400">Voir la liste des épisodes</a>
								</div>
								<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
									{% for video in videos %}
										<div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow-sm dark:bg-gray-800 dark:border-gray-700 overflow-hidden dark:hover:bg-gray-700 transition">
											<a href="{{ video.url }}" target="_blank">
												<img class="rounded-t-lg w-full h-48 object-cover" src="{{ video.thumbnail }}" alt="{{ video.title }}" />
											</a>
											<div class="p-5">
												<a href="{{ video.url }}" target="_blank">
													<h5 class="mb-2 text-xl font-bold tracking-tight text-gray-900 dark:text-white">
														{{ video.title | raw }}
													</h5>
												</a>
												{% if video.description is defined and video.description %}
													<p class="mb-3 font-normal text-gray-700 dark:text-gray-400">
														{{ video.description | raw }}
													</p>
												{% endif %}
											</div>
										</div>
									{% endfor %}
								</div>
							</div>
						</div>

                        <div class="text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 dark:bg-gray-800 dark:text-white rounded-lg p-4 mt-6 rounded-lg p-4 mt-6">
							<div class="flex justify-between items-center mb-2">
								<h3 class="font-semibold text-gray-900 dark:text-white">
									🎢 Quiz en tendance ou populaires</h3>
								<button class="px-4 py-2 bg-[#000000] text-[#000000] font-semibold dark:bg-white rounded-lg">Démarrer</button>
							</div>
							<p class="text-sm text-gray-900 dark:text-white">Orientez vous vers les quiz les plus vivants et les plus tendances !</p>
						</div>


                        <div class="text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 dark:bg-gray-800 dark:text-white rounded-lg p-4 mt-6 rounded-lg p-4 mt-6">
							<div class="flex justify-between items-center mb-2">
								<h3 class="font-semibold text-gray-900 dark:text-white">
									👑 Challenge du jour !</h3>
								<button class="px-4 py-2 bg-[#000000] text-[#000000] dark:bg-white font-semibold rounded-lg">Relever le défi</button>
							</div>
							<p class="text-sm text-gray-900 dark:text-white">Cette semaine relève le défi et répond au quiz le plus rapidement possible tout en ayant le plus de bonne réponse possible.</p>
						</div>

                        <div class="text-gray-900 bg-white rounded-lg border border-gray-100 shadow dark:border-gray-600 dark:bg-gray-800 dark:text-white rounded-lg p-4 mt-6 rounded-lg p-4 mt-6">
							<div class="flex justify-between items-center mb-2">
								<h3 class="font-semibold text-gray-900 dark:text-white">
									🙋 Mon Profil Quiz</h3>
								<button class="px-4 py-2 bg-[#000000] text-[#000000] dark:bg-white font-semibold rounded-lg">Voir</button>
							</div>
							<p class="text-sm text-gray-900 dark:text-white">Voir mes performances sur les précédents quiz.</p>
						</div>
					</div>
					{% include 'quiz/_side.html.twig' %}
				</div>
			</div>
		</div>
	{% endblock %}
