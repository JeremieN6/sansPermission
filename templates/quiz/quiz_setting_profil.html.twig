{% extends 'base_login.html.twig' %}

{% block title %}PodQuizMaster Settings
{% endblock %}

{% block body %}
	<div class="flex h-screen bg-white dark:bg-gray-900 text-gray-900 dark:text-white">
		{% include 'quiz/_navbar.html.twig' %}
		<div class="flex-1 overflow-auto">
			<div class="p-8">
				<div class="flex items-center gap-6 mb-8">
					<div class="w-28 h-28 rounded-full flex items-center justify-center bg-gray-300 border-4 border-gray-300 text-6xl font-bold text-gray-700 select-none">
						{{ pseudo|slice(0, 1)|upper }}
					</div>
					<div>
						<h1 class="text-3xl font-bold mb-1">Paramètres</h1>
						<div class="flex items-center text-sm text-gray-600">
							<span>⚙️</span>
							<span>Paramètres du profil Sans Permission de {{prenom}}</span>
						</div>
					</div>
				</div>
				<h2 class="text-xl font-semibold mb-4">Mes informations personnelles</h2>

				<div class="flex flex-col lg:flex-row w-full gap-4">
					<div class="w-full lg:w-1/2">
						{# Premier bloc (formulaire) #}
						<div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700 rounded-2xl p-6 mb-6">
							{{ form_start(form) }}
							<div class="flex flex-col gap-4 mb-4">
								<div>
									{{ form_label(form.nom) }}
									{{ form_widget(form.nom, {'attr': {'class': 'block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500'}}) }}
								</div>
								<div>
									{{ form_label(form.prenom) }}
									{{ form_widget(form.prenom, {'attr': {'class': 'block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500'}}) }}
								</div>
								<div>
									{{ form_label(form.pseudo) }}
									{{ form_widget(form.pseudo, {'attr': {'class': 'block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500'}}) }}
								</div>
								<div>
									{{ form_label(form.email) }}
									{{ form_widget(form.email, {'attr': {'class': 'block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500'}}) }}
								</div>
								<div>
									{{ form_label(form.age) }}
									{{ form_widget(form.age, {'attr': {'class': 'block w-full p-4 ps-10 text-sm text-gray-900 border border-gray-300 rounded-lg bg-gray-50 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500'}}) }}
								</div>
							</div>
							<div class="flex gap-4 mb-4">
								<button type="submit" class="bg-red-500 text-white rounded-full px-8 py-2 font-semibold">Enregistrer</button>
								<a href="{{ path('forgetten_password') }}" class="bg-black text-white rounded-full px-8 py-2 font-semibold flex items-center">Modifier mon mot de passe</a>
							</div>
							{{ form_end(form) }}
						</div>
					</div>
					<div class="w-full lg:w-1/2">
						{# Deuxième bloc (Premium + Notifications) #}
						<div class="flex flex-col gap-6">
							<div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700 rounded-2xl p-6">
								<h3 class="text-lg font-semibold mb-2">Plan Premium</h3>
								<p class="mb-4">Accédez à tous les quiz en illimités. Mettez toutes les chances de votre côté pour décrocher les meilleurs récompenses ?</p>
								<button class="bg-black text-white rounded-full px-8 py-2 font-semibold">S'abonner</button>
							</div>
							<div class="bg-white border border-gray-200 rounded-lg shadow-sm hover:bg-gray-100 dark:bg-gray-800 dark:border-gray-700 dark:hover:bg-gray-700 rounded-2xl p-6">
								<h3 class="text-lg font-semibold mb-2">Alerte &amp; Notifications</h3>
								<p class="mb-4">Comment souhaitez vous recevoir les notifications ? Soyez au courant des derniers quiz ajoutés, des nouvelles récompenses, d'un évenement ou d'un tirage au sort.</p>
								<div class="flex flex-col lg:flex-row w-full gap-2 sm:gap-4">
									<button class="flex items-center justify-center text-center bg-black text-white rounded-full px-4 sm:px-8 py-2 font-semibold w-full sm:w-auto">
										<span class="mr-2">📧</span> Mail
									</button>
									<button class="flex items-center justify-center text-center bg-black text-white rounded-full px-4 sm:px-8 py-2 font-semibold w-full sm:w-auto">
										<span class="mr-2">📨</span> SMS
									</button>
									<button class="flex items-center justify-center text-center bg-red-500 text-white rounded-full px-4 sm:px-8 py-2 font-semibold w-full sm:w-auto">
										<span class="mr-2">✖️</span> Désactiver
									</button>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
