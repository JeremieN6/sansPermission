{% extends 'base_login.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="flex items-center justify-center bg-gray-100">
    <div class="flex w-full bg-white shadow-md overflow-hidden h-screen">
        {# Section de gauche avec l'illustration - cachée en mobile #}
        <div class="hidden sm:flex w-1/3 xl:w-1/2 bg-[#450996] container-logo flex justify-center items-center">
            <img src="{{asset('assets/images/logo-no-bg.png')}}" alt="" class="container-logo w-1/3">
        </div>

        {# Section de droite avec le formulaire #}
        <div class="flex items-center justify-center flex-col md:w-2/3 xl:w-1/2 p-8 space-y-6">
            <div class="container-title">
                <h1 class="text-3xl font-bold text-center text-gray-900">Inscription</h1>
            </div>

            <div class="w-3/4 space-y-4">
            {{ form_errors(registrationForm) }}

<div class="flex flex-col">
   
{{ form_start(registrationForm, {
    attr: {'class': 'flex flex-col w-full'}
}) }} 
<div class="flex flex-row gap-10">
    <div class="w-1/2">
    {{ form_row(registrationForm.nom, {
        label_attr: {'class': 'block text-sm font-medium text-gray-700'}
    }) }}
        {{ form_row(registrationForm.prenom, {
        label_attr: {'class': 'block text-sm font-medium text-gray-700'}
    }) }}
    {{ form_row(registrationForm.email, {
        label_attr: {'class': 'block text-sm font-medium text-gray-700'}
    }) }}
    </div>

    <div class="w-1/2">
        {{ form_row(registrationForm.age, {
        label_attr: {'class': 'block text-sm font-medium text-gray-700'}
    }) }}
    {{ form_row(registrationForm.pseudo, {
        label_attr: {'class': 'block text-sm font-medium text-gray-700'}
    }) }}
    {{ form_row(registrationForm.plainPassword, {
        label: 'Mot de Passe'
    }) }}
    </div>
    </div>
    <div class="__registerForm__customAlignment">
        {{ form_row(registrationForm.rgpd) }}
    </div>
</div>

                   <div class="container_button mt-2">
                    <button type="submit" class="w-full py-2 px-4 bg-[#450996] text-white font-medium rounded-md hover:bg-[#4B25B6] transition duration-300">
                        S'inscrire
                    </button>
                </div>

    <p>Déjà inscrit(e) ? <a href="{{ path('app_login')}}" class="underline">Me connecter</a></p>
{{ form_end(registrationForm) }}
            </div>
        </div>
    </div>
</div>

{% endblock %}