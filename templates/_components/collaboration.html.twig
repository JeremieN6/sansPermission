<div class="bg-white dark:bg-gray-900 py-24">
    <div class="max-w-7xl mx-auto px-8 flex">
        <!-- Left Column -->
        <div class="w-1/2 pr-8">
            <h2 class="text-4xl font-bold text-[#091D1C] mb-4">Collaboration</h2>
            <p class="text-lg text-gray-800 mb-4">
                Nous sommes toujours ouvert à de nouvelles opportunités de collaborations. Si vous êtes intéressés à l'idée de travailler avec nous, vous pouvez remplir ce formulaire ci-dessous. A très vite !
            </p>
            <button id="collaborationButton" class="inline-block px-6 py-2 bg-[#4ADE80] text-black font-medium rounded-full hover:bg-[#22c55e] transition duration-300">
                Nous contacter
            </button>
        </div>

        <!-- Right Column -->
        <div class="w-1/2">
            <img src="{{asset('assets/images/collab-youtube.webp')}}" loading="lazy" alt="Collaboration Youtube Illustration" class="rounded-lg">
        </div>
    </div>

    <!-- Modal for Collaboration Form -->
    <div id="collaborationModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-50 hidden">
        <div class="bg-[#002626]  rounded-lg p-8 w-1/3 relative">
            <h3 class="text-2xl text-white font-bold mb-4 px-8">Collaborons ensemble</h3>
            <div class="w-full px-8">
                {{ form_start(form) }}
                <div class="flex flex-row gap-8 w-full">
                    <div class="mb-2 w-full">
                        {{ form_row(form.name) }}
                    </div>
                    <div class="mb-2 w-full">
                        {{ form_row(form.email) }}
                    </div>
                </div>
                <div class="flex flex-row gap-8 w-full">
                    <div class="mb-2 w-full">
                        {{ form_row(form.companyName) }}
                    </div>
                    <div class="mb-2 w-full">
                        {{ form_row(form.website) }}
                    </div>
                </div>
                    <div class="mb-2">
                        {{ form_row(form.message) }}
                    </div>
                    <div class="mt-4">
                        <button type="button" id="closeModal" class="absolute text-xl text-white top-3 right-5">X</button>
                    </div>
                {{ form_end(form) }}
            </div>

        </div>
    </div>
</div>

<script>
    document.getElementById('collaborationButton').onclick = function() {
        document.getElementById('collaborationModal').classList.remove('hidden');
    };
    document.getElementById('closeModal').onclick = function() {
        document.getElementById('collaborationModal').classList.add('hidden');
    };
</script> 