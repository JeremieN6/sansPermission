<script>
    const testimonials = [
        {
            quote: "L'innovation est la clé du succès dans le monde moderne.",
            name: "Fabrice Epelboin",
            profession: "Entrepreneur & spécialiste en cybersécurité",
            image: "{{ asset('assets/images/guests/fabrice-epelboin.jpg') }}"
        },
        {
            quote: "Tous les gens pourraient devenir millionnaire, en partant de ZÉRO, avec la bourse !",
            name: "Mounir Laggoune",
            profession: "CEO de Finary",
            image: "{{ asset('assets/images/guests/mounir-laggoune.jpg') }}"
        },
        {
            quote: "Le succès est le résultat de la préparation, du travail acharné et de l'apprentissage de l'échec.",
            name: "Yoan Drahy",
            profession: "Co-fondateur LIMOVA AI / MOVALI AI",
            image: "{{ asset('assets/images/guests/yoan-drahy.jpg') }}"
        }
    ];

    let currentIndex = 0;

    function updateTestimonial() {
        const testimonial = testimonials[currentIndex];
        document.getElementById('testimonial-quote').textContent = testimonial.quote;
        document.getElementById('testimonial-name').textContent = testimonial.name;
        document.getElementById('testimonial-profession').textContent = testimonial.profession;
        document.getElementById('testimonial-image').src = testimonial.image;
        document.getElementById('testimonial-image').alt = "Photo de " + testimonial.name;
    }

    document.getElementById('prevTestimonial').addEventListener("click", function() {
        currentIndex = (currentIndex > 0) ? currentIndex - 1 : testimonials.length - 1;
        updateTestimonial();
    });

    document.getElementById('nextTestimonial').addEventListener("click", function() {
        currentIndex = (currentIndex < testimonials.length - 1) ? currentIndex + 1 : 0;
        updateTestimonial();
    });

    // Initialisation avec le premier témoignage
    updateTestimonial();
</script>