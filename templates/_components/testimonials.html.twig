                    fill="currentColor" />
            </svg>
            <blockquote>
                <p class="text-2xl font-medium text-gray-900 dark:text-white testimonial-quote" id="testimonial-quote">"Tous les gens pourraient devenir millionnaire, en partant de ZÉRO, avec la bourse !"</p>
            </blockquote>
            <figcaption class="flex items-center justify-center mt-6 space-x-3">
                <img class="w-6 h-6 rounded-full"
                    id="testimonial-image" src="{{asset('assets/images/guests/mounir-laggoune.jpg')}}"
                    alt="Invité Sans Permission">
                <div class="flex items-center divide-x-2 divide-gray-500 dark:divide-gray-700">
                    <div class="pr-3 font-medium text-gray-900 dark:text-white" id="testimonial-name">Mounir Laggoune</div>
                    <div class="pl-3 text-sm font-light text-gray-500 dark:text-gray-400" id="testimonial-profession">CEO de Finary</div>
                </div>
            </figcaption>
        </figure>
        <!-- Carousel Controls -->
        <div class="flex justify-center mt-6">
            <button id="prevTestimonial" class="px-4 py-2 bg-gray-800 dark:bg-white text-white dark:text-gray-700 rounded-full hover:bg-700 dark:hover:bg-500 transition duration-300">←</button>
            <button id="nextTestimonial" class="px-4 py-2 bg-gray-800 dark:bg-white text-white dark:text-gray-700 rounded-full hover:bg-700 dark:hover:bg-500 transition duration-300 ml-4">→</button>
        </div>
