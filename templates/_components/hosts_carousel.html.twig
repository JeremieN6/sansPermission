<script>
	const hosts = [
		{
			name: "Fabrice Epelboin",
			location: "Paris, France",
			description: "Fabrice Epelboin est un entrepreneur, enseignant et spécialiste des médias et de la cybersécurité. Il est connu pour son expertise sur les sujets liés à la surveillance numérique, la cyberdéfense, la censure sur internet et l'influence des réseaux sociaux.",
			linkedin: "https://www.linkedin.com/in/epelboin?originalSubdomain=fr",
			twitter: "https://x.com/epelboin?lang=fr",
			image: "{{ asset('assets/images/guests/fabrice-epelboin.jpg') }}"
		},
		{
			name: "Mounir Laggoune",
			location: "Paris, France",
			description: "Mounir Laggoune est le co-fondateur et PDG de Finary, une plateforme innovante de gestion de patrimoine lancée en 2020.",
			linkedin: "https://www.linkedin.com/in/mounirlaggoune/",
			instagram: "https://www.instagram.com/mounir_laggoune/?hl=fr",
			website: "https://finary.com/fr",
			image: "{{ asset('assets/images/guests/mounir-laggoune-2.jpg') }}"
		},
		{
			name: "Yoan Drahy",
			location: "Nice, France",
			description: "Yoan Drahy est un entrepreneur spécialisé dans l'intelligence artificielle et les solutions SaaS.",
			linkedin: "https://www.linkedin.com/in/yoan-drahy-624652333/",
			instagram: "https://www.instagram.com/yoandrahy/",
			website: "https://www.limova.ai/en/",
			tiktok: "https://www.tiktok.com/@yoan.drahy",
			image: "{{ asset('assets/images/guests/yoan-drahy.jpg') }}"
		},
		// Ajoutez d'autres hôtes ici
	];

	let currentHostIndex = 0;

	function updateHost() {
		const host = hosts[currentHostIndex];
		document.getElementById('host-name').innerText = host.name;
		document.getElementById('host-location').innerText = host.location;
		document.getElementById('host-description').innerText = host.description;
		document.getElementById('host-image').src = host.image;

		// Mettre à jour les liens des réseaux sociaux
		document.getElementById('host-linkedin').href = host.linkedin || '#';
		document.getElementById('host-instagram').href = host.instagram || '#';
		document.getElementById('host-website').href = host.website || '#';
		document.getElementById('host-twitter').href = host.twitter || '#';
		document.getElementById('host-tiktok').href = host.tiktok || '#';

		// Afficher ou masquer les icônes en fonction de la disponibilité des liens
		document.getElementById('host-linkedin').style.display = host.linkedin ? 'inline' : 'none';
		document.getElementById('host-instagram').style.display = host.instagram ? 'inline' : 'none';
		document.getElementById('host-website').style.display = host.website ? 'inline' : 'none';
		document.getElementById('host-twitter').style.display = host.twitter ? 'inline' : 'none';
		document.getElementById('host-tiktok').style.display = host.tiktok ? 'inline' : 'none';
	}

	document.getElementById('prevHost').onclick = function() {
		currentHostIndex = (currentHostIndex > 0) ? currentHostIndex - 1 : hosts.length - 1;
		updateHost();
	};

	document.getElementById('nextHost').onclick = function() {
		currentHostIndex = (currentHostIndex < hosts.length - 1) ? currentHostIndex + 1 : 0;
		updateHost();
	};

	// Initialiser le premier hôte
	updateHost();
</script>
