{% extends 'base.html.twig' %}

{% block title %}Contact{% endblock %}

{% block body %}
<section class="py-14 lg:py-6 relative z-0 bg-gray-50">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative text-center">
        <h1 class="max-w-2xl mx-auto text-center font-manrope font-bold text-4xl text-gray-900 mb-5 md:text-5xl md:leading-normal">
            Contactez-Nous
        </h1>
        <p class="text-center text-base font-normal leading-7 text-gray-500 mb-9">
            Nous serions ravis d'avoir de vos nouvelles. <br> Remplissez le formulaire ci-dessous pour nous contacter.
        </p>
    </div>
</section>

<section class="bg-[#FFFFFF] py-12">
    <div class="max-w-7xl mx-auto px-8">
    {{ form_start(contactForm)}}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                   {{ form_row(contactForm.nom) }}
                </div>
                <div>
                    {{ form_row(contactForm.email) }}
                </div>
            </div>
            <div class="my-2">
               {{ form_row(contactForm.message) }}
            </div>
        {{form_end(contactForm)}}
    </div>
</section>

<section class="py-14 lg:py-18 bg-gray-50">
    <div class="flex justify-start flex-col items-start max-w-7xl px-4 sm:px-6 lg:px-8 relative">
        <h2 class="text-4xl font-manrope font-bold text-gray-900 text-center mb-8">Où nous trouver ?</h2>
        <p class="text-lg text-gray-500 leading-8 text-center">
            Vous pouvez également nous contacter via nos réseaux sociaux ou nous rendre visite à notre bureau. Nous sommes impatients de vous entendre !
        </p>
    </div>
</section>

{% endblock %}