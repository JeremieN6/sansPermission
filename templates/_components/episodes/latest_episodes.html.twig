<div class="bg-white dark:bg-gray-900 py-24">
    <div class="max-w-7xl mx-auto px-8">
        <div class="flex justify-between" id="episodes_ancre">
            <h2 class="text-4xl font-bold text-#091D1C mb-12">Derniers épisodes</h2>
            <a href="https://www.youtube.com/@sanspermissionpodcast/videos" target="_blank" class="text-#091D1C font-medium hover:text-green-400">Voir tous les épisodes</a>
        </div>
        <div class="grid grid-cols-3 gap-8">
            {% for video in videos %}
            <div class="bg-[#003737] rounded-3xl p-6">
                <div class="container-thumnail relative">
                    <img src="{{ video.thumbnail }}" alt="{{ video.title }}" class="rounded-lg mb-4 w-full">
                    <p class="bg-[#003737] rounded-xl contentDuration text-white text-lg text-bold px-2 absolute top-2 right-6">{{ video.duration }}</p>
                </div>
                <h3 class="text-xl font-semibold text-white">{{ video.title }}</h3>
                <p class="text-white/80">Publié le : {{ video.publishedAt|date('d/m/Y') }}</p>
                <div class="mt-4">
                    <a href="{{ video.url }}"
                        class="inline-block px-4 py-2 bg-[#4ADE80] text-black font-medium rounded-full hover:bg-[#22c55e] hover:scale-95 transition duration-300">
                        Regarder maintenant
                    </a>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
</div>