{% extends 'base.html.twig' %}

{% block body %}
    <div class="container">
        <h1>Questions Générées</h1>
        
        <div class="card mb-4">
            <div class="card-header">
                <h2>Épisode : {{ episode.title }}</h2>
            </div>
            <div class="card-body">
                <h3>Transcript :</h3>
                <div class="transcript-content">
                    {% if transcript is iterable %}
                        {% for part in transcript %}
                            <div class="transcript-part">
                                {{ part|nl2br }}
                            </div>
                            {% if not loop.last %}
                                <hr>
                            {% endif %}
                        {% endfor %}
                    {% else %}
                        {{ transcript|nl2br }}
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h3>Questions générées :</h3>
            </div>
            <div class="card-body">
                <ol>
                    {% for question in questions %}
                        <li>{{ question }}</li>
                    {% endfor %}
                </ol>
            </div>
        </div>
    </div>
{% endblock %}